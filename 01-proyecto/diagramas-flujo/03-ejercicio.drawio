        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    START([INICIO]) --&gt; INPUT[/Leer N/]\n    INPUT --&gt; INIT[i = 0, count = 0]\n    INIT --&gt; LOOP{i &lt; N?}\n    LOOP --&gt;|No| PROB[Prob = count / N]\n    PROB --&gt; DEC{Prob &gt;= 90%?}\n    DEC --&gt;|Yes| ACEPTAR[ACEPTAR]\n    DEC --&gt;|No| RECHAZAR[RECHAZAR]\n    ACEPTAR --&gt; FIN([FIN])\n    RECHAZAR --&gt; FIN\n    LOOP --&gt;|Yes| STEP4[\&quot;Paso 4: Simular AF y AC&lt;br/&gt;ambos triangulares\&quot;]\n    STEP4 --&gt; STEP5[\&quot;Paso 5: Para t = 1 a 5\&quot;]\n    STEP5 --&gt; LOOP_T{t &lt;= 5?}\n    LOOP_T --&gt;|Yes| SIM_X[\&quot;Simular x_t e i_t&lt;br/&gt;ambos triangulares\&quot;]\n    SIM_X --&gt; INF[Calcular inflación acumulada]\n    INF --&gt; INV[Inversión adicional AC]\n    INV --&gt; NOMINAL[\&quot;Flujo nominal = x_t × inflación acum\&quot;]\n    NOMINAL --&gt; DEP[\&quot;Depreciación = AF / 5\&quot;]\n    DEP --&gt; UAI[\&quot;UAI = Flujo nominal - Depreciación - Inversión AC\&quot;]\n    UAI --&gt; IMP[\&quot;Impuestos = max 0, UAI × 50%\&quot;]\n    IMP --&gt; FS[\&quot;Flujo S_t = Flujo nominal - Impuestos - Inversión AC\&quot;]\n    FS --&gt; SIGUIENTE[t++]\n    SIGUIENTE --&gt; LOOP_T\n    LOOP_T --&gt;|No| STEP6[\&quot;Paso 6: VR = 20%AF + 100%AC\&quot;]\n    STEP6 --&gt; STEP7[Paso 7: Flujos finales]\n    STEP7 --&gt; DEF[Desfluar a valores constantes]\n    DEF --&gt; TIR_CALC[Calcular TIR por bisección]\n    TIR_CALC --&gt; CHECK{TIR &gt; 15%?}\n    CHECK --&gt;|Yes| COUNT[count++]\n    CHECK --&gt;|No| NEXT[Guardar resultado]\n    COUNT --&gt; NEXT\n    NEXT --&gt; iPLUS[i++]\n    iPLUS --&gt; LOOP\n    style START fill:#4CAF50,color:#fff\n    style FIN fill:#f44336,color:#fff\n    style DEC fill:#2196F3,color:#fff\n    style CHECK fill:#2196F3,color:#fff\n    style LOOP_T fill:#2196F3,color:#fff\n    style ACEPTAR fill:#4CAF50,color:#fff\n    style RECHAZAR fill:#f44336,color:#fff\n    style STEP6 fill:#FF9800,color:#fff\n    style TIR_CALC fill:#9C27B0,color:#fff&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="e_5HbV0WeYF3yYe2L_2R-191">
