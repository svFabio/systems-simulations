        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    START([INICIO]) --&gt; INPUT[/Leer parámetros: a, b, c, N/]\n    INPUT --&gt; VALIDAR{¿Se cumple 0 &lt; a &lt; b &lt; c?}\n\n    VALIDAR --&gt;|No| ERROR[/Mostrar error de validación/]\n    ERROR --&gt; FIN([FIN])\n\n    VALIDAR --&gt;|Sí| DENOM[Calcular denominador:&lt;br/&gt;-a + b + c]\n    DENOM --&gt; CALC_A1[Calcular A1:&lt;br/&gt;a / denominador]\n    CALC_A1 --&gt; CALC_A2[Calcular A2:&lt;br/&gt;(2b - 2a) / denominador]\n    CALC_A2 --&gt; CALC_A3[Calcular A3:&lt;br/&gt;(c - b) / denominador]\n    CALC_A3 --&gt; INIT[Inicializar:&lt;br/&gt;i = 0]\n\n    INIT --&gt; LOOP{¿i &lt; N?}\n    LOOP --&gt;|No| FIN\n    LOOP --&gt;|Sí| GEN_REGION[Generar R_region]\n    GEN_REGION --&gt; GEN_VALOR[Generar R_valor]\n    GEN_VALOR --&gt; CHECK_R1{¿R_region ≤ A1?}\n\n    CHECK_R1 --&gt;|Sí| REGION_F1[Calcular X:&lt;br/&gt;a × √R_valor&lt;br/&gt;Región = f1]\n    CHECK_R1 --&gt;|No| CHECK_R2{¿R_region ≤ A1 + A2?}\n\n    CHECK_R2 --&gt;|Sí| REGION_F2[Calcular X:&lt;br/&gt;a + (b - a) × R_valor&lt;br/&gt;Región = f2]\n    CHECK_R2 --&gt;|No| REGION_F3[Calcular X:&lt;br/&gt;c - (c - b) × √(1 - R_valor)&lt;br/&gt;Región = f3]\n\n    REGION_F1 --&gt; SAVE[Guardar fila:&lt;br/&gt;R_region, R_valor, Región, X]\n    REGION_F2 --&gt; SAVE\n    REGION_F3 --&gt; SAVE\n\n    SAVE --&gt; INCREMENTAR[Incrementar contador:&lt;br/&gt;i = i + 1]\n    INCREMENTAR --&gt; LOOP\n\n    style START fill:#4CAF50,color:#fff,stroke:#2E7D32,stroke-width:2px\n    style FIN fill:#f44336,color:#fff,stroke:#B71C1C,stroke-width:2px\n    style ERROR fill:#FF9800,color:#fff,stroke:#E65100,stroke-width:2px\n    style VALIDAR fill:#2196F3,color:#fff,stroke:#0D47A1,stroke-width:2px\n    style LOOP fill:#2196F3,color:#fff,stroke:#0D47A1,stroke-width:2px\n    style CHECK_R1 fill:#2196F3,color:#fff,stroke:#0D47A1,stroke-width:2px\n    style CHECK_R2 fill:#2196F3,color:#fff,stroke:#0D47A1,stroke-width:2px\n    style REGIO